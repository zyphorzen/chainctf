# Backend Configuration
PROJECT_NAME="ChainCTF Backend"
API_V1_PREFIX=/api

# Database
# Default SQLite for local dev: sqlite:///./chainctf.db
# PostgreSQL for production: postgresql://ctfuser:ctfpassword@localhost:5432/chainctf
DATABASE_URL=sqlite:///./chainctf.db

# Blockchain
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Verifier Private Key (Authority for EIP-712 signing)
# NEVER commit the production verifier private key!
VERIFIER_PRIVATE_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Authorization Expiry
AUTHORIZATION_DEADLINE_SECONDS=3600
